---
const serviceLinks = [
  'Software a medida',
  'Integración IA',
  'Sitios & E-commerce',
  'Chatbots',
  'Automatización',
];

const studioLinks = [
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Stack', href: '#stack' },
  { label: 'Contacto', href: '#contacto' },
];
---

<footer class="footer">
  <div class="footer-grid">
    <div>
      <div class="footer-logo">
        <img src="/assets/logo-mark.png" alt="JStudio_IA" class="footer-logo-img" onerror="this.style.display='none'" />
        <span class="footer-logo-text">JStudio<span class="logo-accent">_</span>IA</span>
      </div>
      <p class="footer-tagline">Estudio de ingeniería de software con inteligencia artificial integrada.</p>
    </div>
    <div>
      <h5 class="footer-heading">Servicios</h5>
      <ul class="footer-list">
        {serviceLinks.map(link => (
          <li><a href="#servicios" class="footer-link">{link}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h5 class="footer-heading">Estudio</h5>
      <ul class="footer-list">
        {studioLinks.map(link => (
          <li><a href={link.href} class="footer-link">{link.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h5 class="footer-heading">Contacto directo</h5>
      <ul class="footer-list">
        <li><a href="mailto:2002samudiojohan@gmail.com" class="footer-link email-link">2002samudiojohan@gmail.com</a></li>
        <li><a href="tel:+50765247842" class="footer-link">+507 6524-7842</a></li>
        <li><a href="tel:+50768094813" class="footer-link">+507 6809-4813</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-brand">
    <div class="brand-text">JStudio_IA</div>
  </div>

  <div class="footer-bottom">
    <span>&copy; 2026 JStudio_IA · Panamá</span>
    <span>Construido con criterio &amp; IA</span>
  </div>
</footer>

<style>
  .footer {
    max-width: 1200px;
    margin: 0 auto;
    padding: 72px 40px 36px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.2fr;
    gap: 44px;
    margin-bottom: 40px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 14px;
  }

  .footer-logo-img {
    width: 32px;
    height: 32px;
    object-fit: contain;
    display: block;
  }

  .footer-logo-text {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .logo-accent {
    color: var(--accent);
    font-weight: 600;
  }

  .footer-tagline {
    font-family: 'Newsreader', serif;
    font-style: italic;
    font-size: 19px;
    color: var(--ink-2);
    max-width: 34ch;
    line-height: 1.45;
    margin: 0;
  }

  .footer-heading {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted);
    margin: 0 0 18px;
    font-weight: 500;
  }

  .footer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .footer-link {
    color: var(--ink-2);
    text-decoration: none;
    font-size: 14px;
    transition: color .2s;
  }

  .footer-link:hover { color: var(--accent); }

  .email-link { word-break: break-all; }

  .footer-brand {
    text-align: center;
    padding: 8px 0 0;
    user-select: none;
  }

  .brand-text {
    font-size: clamp(64px, 17vw, 232px);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--line-2);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    margin-top: 24px;
  }

  @media (max-width: 768px) {
    .footer { padding: 48px 18px 28px; }
    .footer-grid { grid-template-columns: 1fr; gap: 32px; }
    .brand-text { font-size: clamp(40px, 14vw, 100px); }
    .footer-bottom { flex-direction: column; align-items: center; text-align: center; }
  }
</style>
