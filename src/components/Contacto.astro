---
const contactLinks = [
  { icon: 'email', label: 'Email personal', value: '2002samudiojohan@gmail.com', href: 'mailto:2002samudiojohan@gmail.com' },
  { icon: 'work-email', label: 'Email de trabajo', value: 'johan.samudiotrabajo@gmail.com', href: 'mailto:johan.samudiotrabajo@gmail.com' },
  { icon: 'phone', label: 'Teléfono principal', value: '+507 6524-7842', href: 'tel:+50765247842' },
  { icon: 'mobile', label: 'Teléfono alterno', value: '+507 6809-4813', href: 'tel:+50768094813' },
];

const chipOptions = ['Software a medida', 'Integración IA', 'Web / E-commerce', 'Chatbot', 'Automatización'];
---

<section id="contacto" class="contacto">
  <div class="contacto-inner">
    <div class="section-header" data-reveal="1">
      <div class="section-label"><span class="label-num">04</span><span class="label-line"></span>Contacto</div>
      <h2 class="section-title">Hablemos de tu próximo proyecto.</h2>
      <p class="section-desc">Cuéntame qué quieres construir. Respondo en menos de 24 horas — casi siempre mucho antes.</p>
    </div>

    <div class="contact-grid">
      <div class="founder-card" data-reveal="1">
        <div class="founder-header">
          <div class="founder-avatar">
            <img src="/assets/logo-mark.png" alt="JStudio_IA" class="founder-img" onerror="this.style.display='none'" />
          </div>
          <div>
            <div class="founder-name">Johan Samudio</div>
            <div class="founder-role">Fundador · Desarrollador</div>
          </div>
        </div>

        {contactLinks.map(link => (
          <a href={link.href} class="contact-link">
            <span class="contact-icon-wrap">
              {link.icon === 'email' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              )}
              {link.icon === 'work-email' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 6 10-6"/></svg>
              )}
              {link.icon === 'phone' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              )}
              {link.icon === 'mobile' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12" y2="18"/></svg>
              )}
            </span>
            <span>
              <span class="contact-label">{link.label}</span>
              <span class="contact-value">{link.value}</span>
            </span>
          </a>
        ))}
      </div>

      <div class="form-card" data-reveal="1">
        <div class="form-title">Cuéntame tu idea.</div>
        <div class="form-subtitle">Responde unas preguntas rápidas y prepararé una propuesta.</div>

        <div class="chip-group">
          {chipOptions.map((chip, i) => (
            <button data-chip="1" type="button" class:list={['chip', { active: i === 0 }]}>{chip}</button>
          ))}
        </div>

        <form data-form="1" action="https://formsubmit.co/johan.samudiotrabajo@gmail.com" method="POST">
          <input type="hidden" name="_subject" value="Nuevo proyecto desde JStudio_IA" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_next" value="" />
          <input type="hidden" name="_template" value="table" />
          <input type="text" name="_honey" style="display:none" />
          <div class="form-row">
            <input type="text" name="nombre" required placeholder="Nombre" class="form-input" />
            <input type="email" name="email" required placeholder="Email" class="form-input" />
          </div>
          <div class="form-row">
            <input type="text" name="empresa" placeholder="Empresa (opcional)" class="form-input" />
            <select name="presupuesto" required class="form-input" aria-label="Presupuesto">
              <option value="" disabled selected>Presupuesto</option>
              <option>$1k – $5k</option>
              <option>$5k – $15k</option>
              <option>$15k – $40k</option>
              <option>$40k+</option>
            </select>
          </div>
          <textarea name="mensaje" required placeholder="Describe tu proyecto" class="form-input form-textarea"></textarea>
          <button data-submit="1" type="submit" class="btn-submit">
            Enviar mensaje
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2" fill="currentColor"/></svg>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Chip selector
  const chips = Array.from(document.querySelectorAll('[data-chip]'));
  chips.forEach((c) => c.addEventListener('click', () => {
    chips.forEach((x) => {
      x.classList.toggle('active', x === c);
    });
  }));

  // Contact form
  const form = document.querySelector('[data-form]') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      const btn = form.querySelector('[data-submit]') as HTMLButtonElement;
      if (!btn || btn.dataset.busy) return;
      btn.dataset.busy = '1';
      const original = btn.innerHTML;
      btn.innerHTML = 'Enviando…';
      btn.style.opacity = '0.8';
      fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { 'Accept': 'application/json' }
      }).then(function (res) {
        if (res.ok) {
          btn.innerHTML = '✓ ¡Mensaje recibido!';
          btn.style.background = '#0E9F6E';
          btn.style.opacity = '1';
          setTimeout(function () {
            btn.innerHTML = original;
            btn.style.background = 'var(--accent)';
            form.reset();
            delete btn.dataset.busy;
          }, 2400);
        } else {
          btn.innerHTML = 'Error — intenta de nuevo';
          btn.style.background = '#DC2626';
          btn.style.opacity = '1';
          setTimeout(function () {
            btn.innerHTML = original;
            btn.style.background = 'var(--accent)';
            delete btn.dataset.busy;
          }, 2400);
        }
      }).catch(function () {
        btn.innerHTML = 'Error de red — intenta de nuevo';
        btn.style.background = '#DC2626';
        btn.style.opacity = '1';
        setTimeout(function () {
          btn.innerHTML = original;
          btn.style.background = 'var(--accent)';
          delete btn.dataset.busy;
        }, 2400);
      });
    });
  }
</script>

<style>
  .contacto {
    background: var(--dark);
    margin-top: 120px;
    padding: 110px 0;
    color: #fff;
  }

  .contacto-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .section-header { max-width: 720px; }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    font-weight: 500;
  }

  .label-num { color: var(--accent); }
  .label-line { width: 26px; height: 1px; background: rgba(255,255,255,0.22); }

  .section-title {
    font-size: clamp(30px, 4.4vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.028em;
    font-weight: 600;
    margin: 20px 0 0;
    color: #fff;
  }

  .section-desc {
    font-size: 18px;
    line-height: 1.6;
    color: rgba(255,255,255,0.66);
    margin: 22px 0 0;
    max-width: 58ch;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 28px;
    margin-top: 54px;
  }

  .founder-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 22px;
    padding: 38px;
  }

  .founder-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 30px;
  }

  .founder-avatar {
    width: 58px;
    height: 58px;
    border-radius: 14px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    padding: 9px;
  }

  .founder-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: invert(1);
  }

  .founder-name {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .founder-role {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: rgba(255,255,255,0.5);
    margin-top: 5px;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 15px 16px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 14px;
    margin-bottom: 10px;
    text-decoration: none;
    color: inherit;
    transition: background .25s ease, transform .25s ease;
  }

  .contact-link:last-child { margin-bottom: 0; }

  .contact-link:hover {
    background: rgba(255,255,255,0.09);
    transform: translateX(3px);
  }

  .contact-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: var(--accent);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    color: #fff;
  }

  .contact-label {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255,255,255,0.5);
  }

  .contact-value {
    display: block;
    font-size: 14.5px;
    font-weight: 500;
    margin-top: 3px;
    word-break: break-all;
  }

  /* Form card */
  .form-card {
    background: var(--surface);
    border-radius: 22px;
    padding: 40px;
    color: var(--ink);
  }

  .form-title {
    font-size: 25px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .form-subtitle {
    color: var(--ink-2);
    margin: 8px 0 26px;
    font-size: 15px;
  }

  .chip-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 22px;
  }

  .chip {
    padding: 8px 14px;
    background: transparent;
    color: var(--ink-2);
    border: 1px solid var(--line-2);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    font-family: inherit;
    transition: all .2s ease;
  }

  .chip.active {
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 13px;
    margin-bottom: 13px;
  }

  .form-input {
    width: 100%;
    padding: 14px 15px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 11px;
    font-family: inherit;
    font-size: 14.5px;
    color: var(--ink);
    outline: none;
    transition: border-color .2s, box-shadow .2s;
  }

  .form-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(79,70,229,0.14);
  }

  .form-textarea {
    min-height: 112px;
    resize: vertical;
    margin-bottom: 18px;
  }

  .btn-submit {
    width: 100%;
    padding: 16px;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 12px;
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: transform .2s ease, background .25s ease;
  }

  .btn-submit:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 1024px) {
    .contacto-inner { padding: 0 24px; }
  }

  @media (max-width: 768px) {
    .contacto { padding: 72px 0; }
    .contacto-inner { padding: 0 18px; }
    .contact-grid { grid-template-columns: 1fr; }
    .form-card { padding: 26px; }
    .founder-card { padding: 26px; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>
