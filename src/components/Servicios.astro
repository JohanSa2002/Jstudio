---
const services = [
  {
    num: '01',
    title: 'Desarrollo de software a medida',
    desc: 'Aplicaciones web, sistemas internos, APIs y productos digitales construidos desde cero, con arquitectura limpia, escalable y preparada para crecer.',
    tags: ['React', 'Node.js', 'Python', 'PostgreSQL'],
    icon: 'code',
    featured: true,
    dark: false,
  },
  {
    num: '02',
    title: 'Integración de IA en el negocio',
    desc: 'Incorporamos modelos de lenguaje, visión por computadora y sistemas predictivos directamente en tus flujos de trabajo — no como un añadido, sino como parte del producto.',
    tags: ['OpenAI', 'LangChain', 'Embeddings'],
    icon: 'ai',
    featured: true,
    dark: true,
  },
  {
    num: '03',
    title: 'Sitios web & e-commerce',
    desc: 'Landing pages, catálogos y tiendas online con rendimiento, SEO y un diseño cuidado hasta el último detalle.',
    tags: ['Next.js', 'Stripe', 'CMS'],
    icon: 'web',
    featured: false,
    dark: false,
  },
  {
    num: '04',
    title: 'Automatización de procesos',
    desc: 'Eliminamos el trabajo repetitivo: conectamos tus herramientas, procesamos documentos y automatizamos decisiones con reglas e IA.',
    tags: ['n8n', 'Zapier', 'RPA'],
    icon: 'star',
    featured: false,
    dark: false,
  },
  {
    num: '05',
    title: 'Chatbots & IA conversacional',
    desc: 'Asistentes con memoria y contexto, entrenados con tus datos, para soporte, ventas y atención 24/7 en WhatsApp, web y más.',
    tags: ['GPT', 'WhatsApp API', 'RAG'],
    icon: 'chat',
    featured: false,
    dark: false,
  },
];
---

<section id="servicios" class="servicios">
  <div class="section-header" data-reveal="1">
    <div class="section-label"><span class="label-num">01</span><span class="label-line"></span>Servicios</div>
    <h2 class="section-title">Cinco disciplinas, una sola obsesión: resolver el problema correcto.</h2>
    <p class="section-desc">Acompañamos a empresas, startups y PYMEs a crecer con tecnología bien construida y bien pensada.</p>
  </div>

  <div class="services-grid">
    {services.map((s, i) => (
      <div
        class:list={[
          'service-card',
          { featured: s.featured, dark: s.dark, small: !s.featured }
        ]}
        data-reveal="1"
        data-reveal-delay={String(i > 1 ? (i - 2) * 80 : i * 80)}
      >
        <div class="card-top">
          <div class:list={['card-icon', { 'card-icon-dark': s.dark }]}>
            {s.icon === 'code' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            )}
            {s.icon === 'ai' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v6M12 17v6M4.22 4.22l4.24 4.24M15.54 15.54l4.24 4.24M1 12h6M17 12h6M4.22 19.78l4.24-4.24M15.54 8.46l4.24-4.24"/></svg>
            )}
            {s.icon === 'web' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            )}
            {s.icon === 'star' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3 6 6 .9-4.5 4.3 1 6.3L12 16.8 6.5 19.5l1-6.3L3 8.9 9 8z"/></svg>
            )}
            {s.icon === 'chat' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            )}
          </div>
          <span class:list={['card-num', { 'card-num-dark': s.dark }]}>{s.num}</span>
        </div>
        <h3 class="card-title">{s.title}</h3>
        <p class="card-desc">{s.desc}</p>
        <div class="card-tags">
          {s.tags.map(tag => (
            <span class:list={['tag', { 'tag-dark': s.dark }]}>{tag}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .servicios {
    max-width: 1200px;
    margin: 0 auto;
    padding: 120px 40px 0;
  }

  .section-header { max-width: 720px; }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }

  .label-num { color: var(--accent); }
  .label-line { width: 26px; height: 1px; background: var(--line-2); }

  .section-title {
    font-size: clamp(30px, 4.4vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.028em;
    font-weight: 600;
    margin: 20px 0 0;
    color: var(--ink);
  }

  .section-desc {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 22px 0 0;
    max-width: 60ch;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 18px;
    margin-top: 56px;
  }

  .service-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 30px;
    min-height: 280px;
    display: flex;
    flex-direction: column;
    transition: transform .35s cubic-bezier(.2,.8,.2,1), border-color .3s, box-shadow .35s;
  }

  .service-card.featured { grid-column: span 3; padding: 34px; min-height: 300px; }
  .service-card.small { grid-column: span 2; }

  .service-card.dark {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  .service-card:not(.dark):hover {
    transform: translateY(-5px);
    border-color: var(--line-2);
    box-shadow: 0 30px 60px -34px rgba(20,22,29,0.4);
  }

  .service-card.dark:hover {
    transform: translateY(-5px);
    box-shadow: 0 30px 60px -30px rgba(20,22,29,0.6);
  }

  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .card-icon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: var(--paper);
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    color: var(--ink);
  }

  .card-icon-dark {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.14);
    color: #fff;
  }

  .card-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--muted);
  }

  .card-num-dark { color: rgba(255,255,255,0.5); }

  .card-title {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.18;
    margin: 22px 0 11px;
    color: var(--ink);
  }

  .featured .card-title { font-size: 25px; line-height: 1.15; margin: 24px 0 12px; }
  .dark .card-title { color: #fff; }

  .card-desc {
    color: var(--ink-2);
    font-size: 14.5px;
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .featured .card-desc { font-size: 15px; }
  .dark .card-desc { color: rgba(255,255,255,0.72); }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }

  .featured .card-tags { margin-top: 26px; }

  .tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    padding: 5px 11px;
    border: 1px solid var(--line);
    border-radius: 7px;
    color: var(--ink-2);
  }

  .tag-dark {
    border-color: rgba(255,255,255,0.16);
    color: rgba(255,255,255,0.85);
  }

  @media (max-width: 1024px) {
    .servicios { padding-left: 24px; padding-right: 24px; }
  }

  @media (max-width: 768px) {
    .servicios { padding: 72px 18px 0; }
    .services-grid { grid-template-columns: 1fr; gap: 14px; }
    .service-card.featured,
    .service-card.small { grid-column: span 1; min-height: 0; }
  }
</style>
